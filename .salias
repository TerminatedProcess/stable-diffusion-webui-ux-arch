clear
set -gx ENV_NAME '.venv'
alias rmenv='rm -rf .envrc $ENV_NAME uv.lock; exit'
alias mkenv='mkuv $ENV_NAME 3.10.16'
alias r='clear;./webui.sh'
alias help='clear;./webui.sh --help'

set -gx python_cmd 'python'

function run
   clear
   ./webui.sh --skip-python-version-check --xformers
end

function install
   clear
   removepyall
   python -m ensurepip --upgrade
   python -m pip install --upgrade pip
   # Install PyTorch with CUDA 11.8 (compatible with CUDA 13.0 system)
   python -m pip install torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cu118
   # Install xformers for memory-efficient attention
   python -m pip install xformers==0.0.23.post1 --index-url https://download.pytorch.org/whl/cu118
   # Clone taming-transformers if not exists
   test -d repositories/taming-transformers || git clone https://github.com/CompVis/taming-transformers.git repositories/taming-transformers
   # Create missing __init__.py for taming module
   touch repositories/taming-transformers/taming/__init__.py
   echo "Installation complete! Run 'run' to start the webui"
end

